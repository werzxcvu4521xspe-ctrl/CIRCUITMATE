{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sites-project",
  "account_id": "bd541a281f3d1e3857bcba7b4fe5b591",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "19568f18-c8c0-4a2e-9a94-37d37212adb5"
    }
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {"enabled":false},
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "ca9295ba49e04d54babf796dff96729d"
    }
  ]
,
  "version_metadata": {"binding":"CF_VERSION_METADATA"}
,
  "services": [{"binding":"RESPONSE_STORE","service":"sites-project-response-store","entrypoint":"ResponseStoreService"}]
}
